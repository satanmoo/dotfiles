# ~/.ssh/config.local 로 복사해 자리표시자를 이 기계 값으로 바꾼다. 저장소에 넣지 않는다(chmod 600).
# 키 경로: Secretive 앱에서 키를 눌러 "Public Key Path".

# GitHub 기본 인증 키를 하나로 고정한다(Touch ID 키).
Host github.com
  IdentityFile /Users/YOUR_USER/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys/AUTH_KEY_ID.pub
  IdentitiesOnly yes

# 이 기계에서만 접속하는 호스트(예: 지휘 기계가 다루는 작업기)는 여기에 둔다.
# Host <별칭>
#   HostName <주소>
#   User <계정>
#   IdentityFile /Users/YOUR_USER/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys/HOST_KEY_ID.pub
#   IdentitiesOnly yes
