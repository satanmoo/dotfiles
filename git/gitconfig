# 디렉토리별로 덮어씀
# github desktop 자동 생성
[user]
#	name = <name> 
#	email = <email>
#   signkey = <signkey>

[core]
	editor = vim
	excludesfile = ~/.gitignore-global
	autocrlf = false
	quotepath = false
	precomposeunicode = true

[init]
	defaultBranch = main

[log]
	date = iso8601

[color]
	ui = auto

[fetch]
	prune = true
	prunetags = true

[push]
	default = simple

[pull]
	rebase = true

[rebase]
	autostash = true
	autosquash = true

[merge]
	conflictstyle = zdiff3

[commit]
	verbose = true
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	format = ssh

[credential]
	helper = git-credential-cache

[rerere]
	enabled = true

[help]
	autocorrect = prompt

# 내 계정·조직 저장소만 SSH(Secretive)로 바꾼다. 그 밖의 공개 저장소(Xcode SPM의 Firebase, Unity·Homebrew 의존성 등)는
# HTTPS 익명으로 받는다 — 전체를 SSH로 바꾸면 모든 다운로드가 키(Touch ID)를 요구해 무인 빌드가 멈춘다.
[url "git@github.com:satanmoo/"]
	insteadOf = https://github.com/satanmoo/
[url "git@github.com:sigmastudio-infra/"]
	insteadOf = https://github.com/sigmastudio-infra/
[url "git@github-infra:Sigma-Studio-INC/"]
	insteadOf = https://github.com/Sigma-Studio-INC/

# 디렉토리별 계정 분리
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work
# ~/work/infra/ 만 회사(infra) 계정. ~/work/ 뒤에 두어야 덮어쓴다.
[includeIf "gitdir:~/work/infra/"]
	path = ~/.gitconfig-infra

[includeIf "gitdir:~/personal/"]
	path = ~/.gitconfig-personal

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.gitconfig-personal
