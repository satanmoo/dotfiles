# 전역 신원 하나: 모든 커밋은 개인 계정 satanmoo 로 한다.
# (회사 계정 sigmastudio-infra 는 저장소 소유만, 웹에서 관리. git 신원·키 없음)
[user]
	name = satanmoo
	email = gyo8270@gmail.com

# 기계마다 다른 값(서명 키 경로)은 저장소 밖 로컬 파일에 둔다. 템플릿: git/gitconfig-local.example
[include]
	path = ~/.gitconfig-local

[core]
	editor = vim
	excludesfile = ~/.gitignore-global
	autocrlf = false
	quotepath = false
	precomposeunicode = true

[init]
	defaultBranch = main

[log]
	date = iso8601

[color]
	ui = auto

[fetch]
	prune = true
	prunetags = true

[push]
	default = simple

[pull]
	rebase = true

[rebase]
	autostash = true
	autosquash = true

[merge]
	conflictstyle = zdiff3

[commit]
	verbose = true
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.gitallowedsigners

[credential]
	helper = git-credential-cache

[rerere]
	enabled = true

[help]
	autocorrect = prompt

# 내 계정·조직 저장소만 SSH(Secretive)로 바꾼다. 그 밖의 공개 저장소(Xcode SPM의 Firebase, Unity·Homebrew 의존성 등)는
# HTTPS 익명으로 받는다 — 전체를 SSH로 바꾸면 모든 다운로드가 키(Touch ID)를 요구해 무인 빌드가 멈춘다.
[url "git@github.com:satanmoo/"]
	insteadOf = https://github.com/satanmoo/
[url "git@github.com:sigmastudio-infra/"]
	insteadOf = https://github.com/sigmastudio-infra/
[url "git@github.com:Sigma-Studio-INC/"]
	insteadOf = https://github.com/Sigma-Studio-INC/

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
