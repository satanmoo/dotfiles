# ~/.gitconfig-local 로 복사한 뒤 자리표시자를 이 기계의 실제 값으로 바꾼다. 저장소에는 넣지 않는다.
# 전역 gitconfig 가 맨 끝의 [include] 로 읽으므로 여기 적은 값이 전역 값을 덮는다. 신원(name·email)은 전역에 있으므로 여기엔 기계별 값만 둔다.
#
# 서명 키: Secretive 에서 Protection Level = Notify 로 만든 키(기계당 1개)의 공개키 경로.
#   GitHub 계정(satanmoo)에 Signing Key 로 등록하고, ~/.gitallowedsigners 에도 한 줄 추가한다.
[user]
    signingkey = /Users/YOUR_USER/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys/SIGNING_KEY_ID.pub

# 선택: Claude 데스크톱 앱을 켜 두는 대화형 기계(지휘기). 받기는 HTTPS + gh 토큰, 보내기만 SSH + Touch ID (git/README.md).
# 무인 작업기에는 넣지 않는다 — 배포 키 대신 gh 토큰으로 받게 된다.
# [url "https://github.com/"]
#     insteadOf = git@github.com:
# [url "git@github.com:"]
#     pushInsteadOf = git@github.com:
#     pushInsteadOf = https://github.com/

# 선택: 이 기계만 다른 편집기를 쓸 때(전역 기본 nvim).
# [core]
#     editor = vim
