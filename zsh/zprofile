# PATH·fpath 중복 항목은 처음 것만 남긴다
typeset -U PATH path FPATH fpath

# Homebrew: /opt/homebrew/bin을 macOS 기본 도구보다 앞에
eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# uv tool install로 깐 도구 (pyrefly 등)
path=(~/.local/bin $path)

# Load local config
if [[ -f ~/.zprofile.local ]]; then
  source ~/.zprofile.local
fi
